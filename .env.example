# DATABASE_URL=postgresql://user:password@localhost:5432/bionature
# For MongoDB:
# MONGODB_URI=mongodb://localhost:27017/bionature

# Google Gemini AI Configuration (Optional - falls back to BioNature Domain AI if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
